# Copy this file to .env and paste your Neon connection strings.
# Neon console -> your project -> Connect -> "Connection string".

# POOLED endpoint (host contains "-pooler"). Used by the app and scraper at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# DIRECT endpoint — the same host with "-pooler" removed. Used by Prisma Migrate,
# which needs a real session that the PgBouncer pooler can't provide.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require"

# Leave DATABASE_URL empty or unset to run the crawler without any database writes.

# ─── Archive database (optional) ───────────────────────────────────────────
# A SECOND, separate Postgres database that `npm run db:archive` copies the
# primary database into before clearing it — see "Archiving" in README.md.
# Same pooled/direct split as above, but pointed at the other database.
# Not required for normal crawling; only needed if you use db:archive.
# ARCHIVE_DATABASE_URL="postgresql://USER:PASSWORD@.../DBNAME?sslmode=verify-full&channel_binding=require"
# ARCHIVE_DIRECT_URL="postgresql://USER:PASSWORD@.../DBNAME?sslmode=verify-full&channel_binding=require"

# Set to 1 to dump each lot's FULL raw Copart API response to storage/debug/.
# Only needed when a field is missing/blank and you need to see Copart's real
# field names to fix the mapping in src/main.ts — off by default.
# DEBUG_RAW_API=1
