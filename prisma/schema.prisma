// Output sits under src/ (not the repo root) so `tsc` compiles the generated
// client into dist/ along with everything else. It is gitignored and recreated
// by `prisma generate`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── products is the MAIN table ────────────────────────────────────────────────
//
//   products ⭐
//    ├── category        (many products -> one category:    Vehicles, Electronics, …)
//    ├── subcategory     (many products -> one subcategory: Pickup Trucks, Phones, …)
//    ├── source          (many products -> one website)
//    ├── product_images
//    ├── current_bid     (only for listings with auction/bid data)
//    └── spec
//
// EVERY scraped website writes into this same `products` table, whatever it
// sells — vehicles, car parts, food, electronics. There is no per-site table
// and never should be: a new site is a new ROW in `source` plus a normalizer in
// src/normalize/, nothing more.
//
// Deduplication anchor: (source_id, external_id). `external_id` is whatever the
// site calls its listing — Copart lot number, an Amazon ASIN, a shop's product
// id. Re-scraping an existing listing UPDATES the product row in place.

/// One scraped website.
model Source {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  description String?

  /// Stable machine key used by the normalizer registry, e.g. "copart". The
  /// display name is free text and would be a fragile join key.
  slug String  @unique
  url  String?
  /// "auction" | "retail" | "classifieds" | "dealer"
  type String  @default("auction")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  products Product[]

  @@map("source")
}

/// Top-level product category: Vehicles, Car Parts, Food, Electronics, …
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subcategories Subcategory[]
  products      Product[]

  @@map("category")
}

/// Second level beneath a category: Vehicles > Pickup Trucks,
/// Electronics > Phones / Laptops / TVs, …
model Subcategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategory")
}

/// ⭐ THE MAIN TABLE. One row per product listing, from any website.
model Product {
  id String @id @default(uuid(7)) @db.Uuid

  name        String?
  brand       String?
  /// Headline price in major units: asking price on retail sites, Buy It Now
  /// or the live bid on auction sites.
  price       Decimal? @db.Decimal(12, 2)
  partNumber  String?  @map("part_number")
  sku         String?
  description String?
  rating      Decimal? @db.Decimal(4, 2)
  url         String

  categoryId    String? @map("category_id") @db.Uuid
  subcategoryId String? @map("subcategory_id") @db.Uuid
  /// Denormalized copy of `category.name` (e.g. "Vehicles", "Electronics",
  /// "Car Parts", "Food Items") — kept in sync with categoryId on every write,
  /// so the category is visible on the product row itself without a join.
  categoryName  String? @map("category_name")
  sourceId      String  @map("source_id") @db.Uuid

  /// The site's own listing/product id — Copart lot number, ASIN, etc. Paired
  /// with source_id this is what stops the same listing being inserted twice.
  externalId String @map("external_id")

  /// Untouched scraped payload, so listings can be re-normalized later without
  /// re-crawling the site.
  raw Json?

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastScrapedAt DateTime @default(now()) @map("last_scraped_at") @db.Timestamptz(6)

  source      Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory?   @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  currentBid  CurrentBid?
  specs       Spec[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([categoryName])
  @@index([brand])
  @@index([sku])
  @@index([partNumber])
  @@index([price])
  @@index([lastScrapedAt(sort: Desc)])
  @@map("products")
}

/// Photos for a product, in listing order.
model ProductImage {
  id        String  @id @default(uuid(7)) @db.Uuid
  productId String  @map("product_id") @db.Uuid
  /// The image's canonical remote URL.
  imageUrl  String  @map("image_url")
  /// Where the crawler wrote the file, when it downloaded it.
  path      String?
  /// File size in bytes, when downloaded.
  size      Int?
  isPrimary Boolean @default(false) @map("is_primary")

  /// Position in the gallery. Without it a re-read returns photos in whatever
  /// order Postgres feels like.
  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, imageUrl])
  @@index([productId, sortOrder])
  @@map("product_images")
}

/// Auction pricing. Only exists for products whose site reported bid data;
/// one row per product, updated in place on each re-scrape.
model CurrentBid {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @unique @map("product_id") @db.Uuid

  /// The auction site's lot number, shown alongside the bid. Lives here
  /// rather than in `spec`.
  lotNumber String? @map("lot_number")

  price    Decimal? @db.Decimal(12, 2)
  currency String   @default("USD")

  bidNow   Boolean @default(false) @map("bid_now")
  buyItNow Boolean @default(false) @map("buy_it_now")
  pureSale Boolean @default(false) @map("pure_sale")
  auctions Boolean @default(false)

  /// Parsed auction date; null when the site says something like "Future".
  /// The text as shown on the site is kept in `spec` ("Sale Date"), as is
  /// "Sale Name" for preserving the site's original display values.
  saleDate DateTime? @map("sale_date") @db.Timestamp(6)
  saleName String?   @map("sale_name")

  // Owned by the marketplace app that shares this database (its
  // auctions_and_bids migration). The scraper never writes them.
  minIncrement Decimal?         @map("min_increment") @db.Decimal
  reservePrice Decimal?         @map("reserve_price") @db.Decimal
  status       CurrentBidStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([price])
  @@map("current_bid")
}

enum CurrentBidStatus {
  OPEN
  ENDED
  CANCELLED
}

/// Everything a site reports that isn't a `products` column: VIN, odometer,
/// screen size, RAM, weight, ingredients — whatever the next website invents.
/// Key/value keeps the main table stable no matter how many sites get added.
model Spec {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  key       String
  value     String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
  @@index([key])
  @@map("spec")
}
